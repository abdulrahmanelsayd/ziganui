---
import { Image } from 'astro:assets';
import TeamCircle from '../../assets/hero/truus-team-circle.svg';
import TeamUnderline from '../../assets/hero/truus-team-underline.svg';
import { home } from '../../data/home';
import { photos } from '../../data/photos';
import { trialUrl } from '../../data/site';
const { hero } = home;
---
<svg class="hero-edge-definitions" width="0" height="0" aria-hidden="true" focusable="false"><defs><clipPath id="zigan-hero-edge-desktop" clipPathUnits="objectBoundingBox"><path d="M0 0H1V.78Q.945 1 .8 1H.2Q.055 1 0 .78Z"/></clipPath><clipPath id="zigan-hero-edge-mobile" clipPathUnits="objectBoundingBox"><path d="M0 0H1V.9025Q.5 1.0975 0 .9025Z"/></clipPath></defs></svg>
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-edge-surface">
  {photos.hero && <Image class="hero-image" src={photos.hero.src} alt={photos.hero.alt} widths={[640, 960, 1280, 1672]} sizes="(max-width: 359px) max(100vw, calc(min(560px, 100svh) * 1.77683)), (max-width: 767px) max(100vw, calc(min(600px, 100svh) * 1.77683)), 100vw" format="webp" quality={85} loading="eager" fetchpriority="high" decoding="async" />}
  <div class="hero-shade" aria-hidden="true"></div>
  </div>
  <div class="hero-copy">
    <h1 id="hero-title" aria-label={`${hero.brand}. ${hero.lead} ${hero.focus}.`}><span class="hero-line"><span class="hero-mark hero-mark--circle">{hero.brand}<TeamCircle aria-hidden="true" focusable="false" /></span>.</span>{' '}<span class="hero-line hero-line--accent">{hero.lead}{' '}<span class="hero-mark hero-mark--underline">{hero.focus}<TeamUnderline aria-hidden="true" focusable="false" /></span>.</span></h1>
    <p class="hero-supporting">{hero.supporting}</p>
    <p class="hero-audience">{hero.audience}</p>
    <div class="hero-actions"><a class="hero-cta" href={trialUrl} target="_blank" rel="noopener noreferrer" data-trial>{hero.primary}</a></div>
  </div>
</section>
<style>
  .hero { --color-action: #D84B00; position: relative; isolation: isolate; background: var(--color-text); color: var(--color-page); min-height: 100svh; padding: 0; display: grid; grid-template-rows: minmax(min-content, 1fr); place-items: stretch; text-align: center; overflow: hidden; }
  .hero-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; z-index: -2; }
  .hero-shade { position: absolute; inset: 0; pointer-events: none; z-index: -1; background: linear-gradient(180deg,rgba(8,13,10,.28) 0%,rgba(8,13,10,.55) 38%,rgba(8,13,10,.66) 100%),radial-gradient(ellipse at 50% 48%,rgba(6,10,8,.36) 0%,rgba(6,10,8,.15) 48%,transparent 82%); }
  .hero-copy { align-self: center; width: calc(100% - 96px); max-width: 860px; padding-block: 24px; margin-inline: auto; }
  h1 { font-size: 88px; line-height: 1.35; font-weight: 700; font-style: normal; letter-spacing: 0; overflow: visible; }
  .hero-line { display: block; }
  .hero-line--accent { color: var(--color-action); }
  .hero-mark { position: relative; display: inline-block; white-space: nowrap; font: inherit; color: inherit; }
  .hero-mark--underline { padding-bottom: .16em; }
  .hero-mark :global(svg) { position: absolute; display: block; pointer-events: none; overflow: visible; color: inherit; }
  .hero-mark--circle :global(svg) { left: -.24em; top: 0; width: calc(100% + .48em); height: 1.35em; }
  .hero-mark--underline :global(svg) { left: -.05em; bottom: -.05em; width: calc(100% + .1em); height: .2em; color: var(--color-page); }
  .hero-supporting { font-size: 18px; line-height: 30px; font-weight: 400; color: var(--color-page); max-width: 600px; margin: 20px auto 0; }
  .hero-actions { margin-top: 24px; }
  .hero-cta { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 24px; border-radius: 999px; background: var(--color-page); color: var(--color-text); font-size: 16px; line-height: 24px; font-weight: 500; text-decoration: none; }
  .hero-cta:hover { outline: 2px solid var(--color-action); outline-offset: 5px; }
  .hero-cta:focus-visible { outline: 2px solid var(--color-page); outline-offset: 5px; }
  @media (width < 1024px) { .hero-copy { width: calc(100% - 64px); } h1 { font-size: 68px; } .hero-image { object-position: 40% 50%; } }
  @media (width < 768px) {
    .hero { min-height: min(600px, 100svh); }
    .hero-copy { align-self: end; width: calc(100% - 40px); padding-block: 24px; text-align: right; }
    h1 { font-size: 52px; line-height: 1.3; }
    .hero-line--accent { margin-top: 12px; font-size: clamp(30px, 9.5vw, 52px); line-height: 1.4; white-space: nowrap; }
    .hero-image { object-position: 22% 50%; }
    .hero-supporting { max-width: 300px; margin: 16px 0 0 auto; font-size: 14px; line-height: 24px; text-align: right; }
    .hero-actions { margin-top: 20px; }
    .hero-cta { font-size: 14px; padding-inline: 22px; }
  }
  @media (width < 360px) { .hero { min-height: min(560px, 100svh); } h1 { font-size: 44px; } }
  @media (width < 320px) { .hero-copy { width: calc(100% - 32px); } .hero-line--accent { font-size: 28px; white-space: normal; } }
  @media (width >= 1024px) and (height < 580px) { h1 { font-size: clamp(56px, calc(40svh - 144px), 88px); } }
  @media (768px <= width < 1024px) and (height < 540px) { h1 { font-size: clamp(52px, calc(20svh - 40px), 68px); } }

/* Owner-approved refinement02 overrides; preserve ordering. */
/* Isolated proposal. Existing photo, overlay, marks, header and other sections stay intact. */
.hero.hero { background:#fff; }
.hero-edge-definitions { position:absolute; width:0; height:0; overflow:hidden; pointer-events:none; }
.hero .hero-edge-surface { position:absolute; inset:0; z-index:-1; isolation:isolate; background:#000; overflow:hidden; border-radius:0 0 20% 20% / 0 0 22% 22%; clip-path:url(#zigan-hero-edge-desktop); }
@media (min-width:768px) {
  .hero.hero { padding:88px 0 24px; }
  .hero .hero-copy { align-self:center; width:calc(100% - 96px); max-width:1000px; padding:0; }
  .hero h1 { font-size:clamp(64px,6.1vw,88px); line-height:1.28; }
  .hero .hero-line:first-child { font-size:.84em; line-height:1.35; margin-bottom:.1em; }
  .hero .hero-line--accent { white-space:nowrap; }
  .hero .hero-supporting { max-width:680px; margin:24px auto 0; font-size:19px; line-height:1.8; }
  .hero .hero-audience { max-width:680px; margin:6px auto 0; font-size:14px; line-height:1.8; color:#faf6ee; opacity:.85; }
  .hero .hero-actions { margin-top:26px; }
  .hero .hero-cta { min-height:48px; padding-inline:26px; }
}
@media (min-width:768px) and (max-width:1023px) {
  .hero .hero-copy { width:calc(100% - 64px); }
  .hero h1 { font-size:clamp(50px,7.4vw,68px); }
  .hero .hero-supporting { font-size:18px; }
}
@media (min-width:768px) and (max-height:599px) {
  .hero.hero { padding-top:80px; padding-bottom:24px; }
  .hero h1 { font-size:clamp(48px,min(6vw,13svh),76px); }
  .hero .hero-supporting { margin-top:18px; font-size:17px; line-height:1.7; }
  .hero .hero-audience { margin-top:5px; font-size:13px; line-height:1.7; }
  .hero .hero-actions { margin-top:20px; }
}
@media (max-width:767px) {
  .hero .hero-copy { padding-block:24px 64px; }
  .hero .hero-edge-surface { border-radius:0 0 50% 50% / 0 0 10% 10%; clip-path:url(#zigan-hero-edge-mobile); }
  .hero .hero-supporting { max-width:330px; font-size:15px; line-height:1.8; margin-top:18px; }
  .hero .hero-audience { max-width:330px; margin:6px 0 0 auto; font-size:12px; line-height:1.9; color:#faf6ee; opacity:.85; }
  .hero .hero-actions { margin-top:20px; }
}
@media (max-width:359px) {
  .hero .hero-supporting { font-size:14px; }
  .hero .hero-audience { font-size:11px; }
}

</style>
