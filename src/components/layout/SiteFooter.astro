---
import { site, navigation, enquiryUrl } from '../../data/site';
interface Props { currentPath: string; }
const { currentPath } = Astro.props;
const office = site.locations.find((location) => location.id === 'office')!;
const [plusCode, city, country] = office.address.split('،').map((part) => part.trim());
---
<footer class="site-footer truus-footer" id="footer" data-page-background aria-label="روابط ومقر وتواصل أكاديمية زيغان"><div class="truus-footer-inner"><div class="truus-footer-grid"><nav class="truus-footer-group" aria-labelledby="footer-nav-title"><h2 class="truus-footer-label" id="footer-nav-title">اكتشف زيغان</h2><ul class="truus-footer-nav">{navigation.map((link) => <li><a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a></li>)}</ul></nav><section class="truus-footer-group" aria-labelledby="footer-office-title"><h2 class="truus-footer-label" id="footer-office-title">{office.title}</h2><p class="truus-footer-address">{city}، <br />{country}.</p><p class="truus-footer-code"><bdi dir="ltr">{plusCode}</bdi></p><a class="truus-footer-map" href={office.mapUrl} target="_blank" rel="noopener noreferrer">افتح الخريطة<svg class="truus-footer-underline" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 403 17" fill="none" preserveAspectRatio="none"><path vector-effect="non-scaling-stroke" d="M1 16C25.8389 14.2222 50.643 12.2137 75.2387 9.47009C107.364 5.99145 144.414 1.26496 174.898 1C178.242 1.35897 168.254 2.8718 166.786 3.22223C163.842 3.76924 160.464 4.41881 157.146 5.11966C152.23 6.22223 134.982 9.64957 144.171 12.1282C152.23 13.8974 167.551 13.4701 178.572 13.094C200.11 12.2393 222.066 10.2137 243.639 8.99146C296.296 5.69231 349.291 6.34188 402 8.58975" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
</a></section><section class="truus-footer-group" aria-labelledby="footer-contact-title"><h2 class="truus-footer-label" id="footer-contact-title">تواصل معنا</h2><div class="truus-footer-contact"><a href={site.contact.phoneHref}>اتصل بالأكاديمية</a><a href={enquiryUrl} target="_blank" rel="noopener noreferrer">راسلنا على واتساب</a></div><div class="truus-footer-social"><a href={site.contact.facebook} target="_blank" rel="noopener noreferrer" aria-label="فيسبوك أكاديمية زيغان"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14.8 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.6 1.6-1.6H18V3.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.3H8.5v3.2h2.8V21h3.5Z"/></svg></a><a href={site.contact.instagram} target="_blank" rel="noopener noreferrer" aria-label="إنستجرام أكاديمية زيغان"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a></div></section></div><div class="truus-footer-brand-stage"><a class="truus-footer-wordmark" href="/" aria-label="أكاديمية زيغان لكرة القدم، الرئيسية"><svg class="truus-footer-lettering" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 830 330" fill="currentColor" aria-hidden="true" focusable="false">
